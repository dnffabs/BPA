.decl heap_alloc_call(func:symbol, site:number, allocator:symbol, size:number)
.input heap_alloc_call
.decl heap_boundary(func:symbol, site:number, size:number)
heap_boundary(f,s,n) :- heap_alloc_call(f,s,_,n).
.decl heap_aloc(id:symbol, func:symbol, site:number, size:number)
heap_aloc(cat("heap_",f,"_",to_string(s)),f,s,n) :- heap_boundary(f,s,n).
.output heap_boundary(filename="heap_boundary.facts")
.output heap_aloc(filename="heap_aloc.facts")
