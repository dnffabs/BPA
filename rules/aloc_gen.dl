// Block IDs are identities, not expression IDs or untagged numeric offsets.
.decl stack_boundary(func:symbol, offset:number, size:number)
.input stack_boundary
.decl global_region(name:symbol, start:number, end:number)
.input global_region
.decl stack_aloc(id:symbol, func:symbol, offset:number, size:number)
stack_aloc(cat("stk_",f),f,o,n) :- stack_boundary(f,o,n).
.decl global_aloc(id:symbol, addr:number, size:number)
global_aloc(cat("glb_",name),start,end-start) :- global_region(name,start,end).
// store/load mappings are produced by analysis.dl after points-to is known.
.output stack_aloc(filename="stack_aloc.facts")
.output global_aloc(filename="global_aloc.facts")
