// analysis.dl — 值集分析（BPA-X 阶段五）
//
// 论文 Section D：
//   - 流不敏感（SSA 已编码控制流）
//   - 值集 = {函数起始地址} ∪ {A-loc 基地址}
//   - 追踪 SSA 寄存器 + VEX 临时寄存器
//   - Soufflé 递归规则自动完成不动点迭代
//   - 最终解析间接调用目标（PUT(rip) = t → t 的值集中的函数地址）
//
// 输入: filter_set_loc_vex, filter_set_mem_vex, filter_get_mem_vex_exp,
//        filter_binop_vex_exp, call_site_raw,
//        filtered_func, stack_aloc, global_aloc, heap_aloc,
//        ssa_def, reaching_def_exit, get_loc_vex_exp
// 输出: value_set, indirect_call_target

// ── 输入声明 ──────────────────────────────────────────────────────────────────

.decl filter_set_loc_vex(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:number, regEid:number)
.input filter_set_loc_vex

.decl filter_binop_vex_exp(addr:number, op:symbol, arg1Eid:number, arg2Eid:number, resultEid:number)
.input filter_binop_vex_exp

.decl filtered_func(func:symbol, start_addr:number, end_addr:number)
.input filtered_func

.decl get_loc_vex_exp(regName:symbol, regEid:number)
.input get_loc_vex_exp

.decl stack_aloc(alocId:symbol, func:symbol, offset:number, size:number)
.input stack_aloc(filename="stack_aloc.facts")

.decl global_aloc(alocId:symbol, addr:number, size:number)
.input global_aloc(filename="global_aloc.facts")

.decl heap_aloc(alocId:symbol, func:symbol, callSite:number, size:number)
.input heap_aloc(filename="heap_aloc.facts")

.decl call_site_raw(caller_irsb:number, instr_addr:number, target_addr:number)
.input call_site_raw(filename="call_site_raw.facts")

.decl filter_set_mem_vex(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:number, addrEid:number)
.input filter_set_mem_vex

.decl filter_get_mem_vex_exp(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:symbol, addrEid:number)
.input filter_get_mem_vex_exp

.decl reaching_def_exit(func:symbol, irsb:number, regEid:number, version:number)
.input reaching_def_exit(filename="reaching_def_exit.facts")

// ── Step 1: 初始值集种子 ──────────────────────────────────────────────────────

// 函数起始地址集合
.decl func_start(func:symbol, addr:number)
func_start(func, addr) :- filtered_func(func, addr, _).

// A-loc 基地址集合
.decl aloc_base(alocId:symbol, addr:number)
aloc_base(id, offset) :- stack_aloc(id, _, offset, _).  // 栈偏移作为"地址"
aloc_base(id, addr)   :- global_aloc(id, addr, _).
aloc_base(id, site)   :- heap_aloc(id, _, site, _).

// ── Step 2: 值集传播（流不敏感，递归至不动点）────────────────────────────────
// value_set(eid, value): EID 可能持有的值（函数地址或 A-loc 基地址）

.decl value_set(eid:number, value:number)

// 种子1：立即数 EID 等于函数起始地址（由 extract_imm_func_eid.py 预处理）
.decl imm_func_addr_eid(conEid:number, addr:number)
.input imm_func_addr_eid(filename="imm_func_addr_eid.facts")

value_set(conEid, addr) :- imm_func_addr_eid(conEid, addr).

// 种子2：立即数 EID 等于全局 A-loc 基地址（用预处理文件避免溢出）
.decl imm_global_eid(conEid:number, addr:number)
.input imm_global_eid(filename="imm_global_eid.facts")

value_set(conEid, addr) :- imm_global_eid(conEid, addr).

// 传播1：寄存器赋值 regEid = dataEid → regEid 继承 dataEid 的值集
value_set(regEid, v) :-
    filter_set_loc_vex(_, _, _, _, _, dataEid, regEid),
    value_set(dataEid, v).

// 传播2：binop 结果（Add/Sub）— 保守处理：结果继承操作数的值集
// （精确偏移计算超出本阶段范围，保守传播保证 soundness）
value_set(resultEid, v) :-
    filter_binop_vex_exp(_, op, arg1Eid, _, resultEid),
    (op = "Add64" ; op = "Add32" ; op = "Sub64" ; op = "Sub32"),
    value_set(arg1Eid, v).

value_set(resultEid, v) :-
    filter_binop_vex_exp(_, op, _, arg2Eid, resultEid),
    (op = "Add64" ; op = "Add32"),
    value_set(arg2Eid, v).

// 传播3：跨 IRSB — 通过 reaching_def_exit 传播架构寄存器值集
.decl arch_reg_eid(regEid:number)
arch_reg_eid(eid) :-
    get_loc_vex_exp(name, eid),
    (name = "rax" ; name = "rbx" ; name = "rcx" ; name = "rdx" ;
     name = "rsi" ; name = "rdi" ; name = "rsp" ; name = "rbp" ;
     name = "r8"  ; name = "r9"  ; name = "r10" ; name = "r11" ;
     name = "r12" ; name = "r13" ; name = "r14" ; name = "r15" ;
     name = "eax" ; name = "ebx" ; name = "ecx" ; name = "edx" ;
     name = "esi" ; name = "edi" ; name = "esp" ; name = "ebp").

// 若某 IRSB 出口处寄存器 regEid 的 reaching def 版本（= instrAddr）有值集
// 则该寄存器 EID 也继承该值集
value_set(regEid, v) :-
    reaching_def_exit(_, _, regEid, version),
    arch_reg_eid(regEid),
    value_set(version, v).

// 传播4：内存 store→load — 同一地址 EID 的存取传播值集
// store: set_mem_vex(dataEid, addrEid) → load: get_mem_vex_exp(loadEid, addrEid)
// 若 dataEid 有值集，则 loadEid 继承（保守：忽略别名，仅匹配相同 addrEid）
.decl mem_store_value(addrEid:number, v:number)
mem_store_value(addrEid, v) :-
    filter_set_mem_vex(_, _, _, _, _, dataEid, addrEid),
    value_set(dataEid, v).

value_set(loadRegEid, v) :-
    filter_get_mem_vex_exp(_, _, instrAddr, _, _, _, addrEid),
    mem_store_value(addrEid, v),
    // loadRegEid: 该 load 结果写入的寄存器（同一指令的 set_loc_vex irOrder=1）
    filter_set_loc_vex(_, _, instrAddr, 1, _, _, loadRegEid).

// ── Step 3: 间接调用解析 ──────────────────────────────────────────────────────
// VEX IR 中间接调用（call *%rax）表现为：
//   call_site_raw(irsb, instr, target) 其中 target 不是用户函数起始地址
// 间接调用指令的 irOrder=1 处：t_dst = t_src（t_src 持有函数指针）
// 通过 value_set(t_src) 解析实际目标

// 间接调用点：call_site_raw 中 target=0（set()）或 target 不是用户函数起始地址
.decl indirect_call_site(irsb:number, instrAddr:number)
indirect_call_site(irsb, instr) :-
    call_site_raw(irsb, instr, 0).
indirect_call_site(irsb, instr) :-
    call_site_raw(irsb, instr, target),
    target != 0,
    !func_start(_, target).

// 间接调用指令处 irOrder=1 的 dataEid 即为函数指针来源
.decl indirect_call_target(callSite:number, targetFunc:symbol)
indirect_call_target(instrAddr, targetFunc) :-
    indirect_call_site(irsb, instrAddr),
    filter_set_loc_vex(_, irsb, instrAddr, 1, _, dataEid, _),
    value_set(dataEid, targetAddr),
    func_start(targetFunc, targetAddr).

// ── 输出 ──────────────────────────────────────────────────────────────────────

.output value_set(filename="value_set.facts")
.output indirect_call_target(filename="indirect_call_target.facts")
