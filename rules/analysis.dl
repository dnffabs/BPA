// Joint interprocedural points-to / call-graph least fixed point.
#include "schema.dl"
.decl def_use(source:number, dest:number)
.input def_use
.decl exit_reg(func:symbol, reg:number, version:number)
.input exit_reg
.decl scalar(eid:number, value:number)
.input scalar
.decl stack_aloc(id:symbol, func:symbol, offset:number, size:number)
.input stack_aloc
.decl global_aloc(id:symbol, addr:number, size:number)
.input global_aloc
.decl heap_aloc(id:symbol, func:symbol, site:number, size:number)
.input heap_aloc
.decl pointer_seed(eid:number, block:symbol)
.input pointer_seed
.decl heap_result(call_stmt:number, eid:number, block:symbol)
.input heap_result
.decl pointer_width(bits:number)
.input pointer_width
.decl abi_sp(reg:number)
.input abi_sp
.decl abi_return(reg:number)
.input abi_return
.decl abi_first_arg(reg:number)
.input abi_first_arg
.decl abi_second_arg(reg:number)
.input abi_second_arg
.decl numeric_top(eid:number)
.input numeric_top

.decl reachable_func(func:symbol)
.decl call_edge(stmt:number, callee:symbol)
.decl external_edge(stmt:number, name:symbol)
.decl flow(source:number, dest:number)
.decl code_value(eid:number, addr:number)
.decl points_to(eid:number, block:symbol)
.decl memory_code(block:symbol, addr:number)
.decl memory_pointer(block:symbol, target:symbol)

reachable_func(f) :- root(f).
reachable_func(g) :- call_edge(_,g).
flow(a,b) :- copy(a,b).
flow(a,b) :- def_use(a,b).
// Register actual/formal and return edges are added as targets become known.
flow(a,b) :- call_edge(s,g), call_input(s,r,a), entry_reg(g,r,b), !abi_sp(r).
// Defined callees provide the actual exit definition of each clobbered register.
flow(a,b) :- call_edge(s,g), exit_reg(g,r,a), call_output(s,r,b).
flow(a,b) :- external_edge(s,n),
    (n = "memcpy"; n = "memmove"; n = "strcpy"; n = "memset"),
    call_input(s,r,a), abi_first_arg(r), call_output(s,ret,b), abi_return(ret).
// Only width-preserving casts transfer pointer/code identities.
flow(a,b) :- unary(b,op,bits,a), pointer_width(w), bits >= w,
    (op = "32Uto64"; op = "32Sto64"; op = "64to64"; op = "32to32").

code_value(e,a) :- scalar(e,a), function(_,a,_).
code_value(e,a) :- scalar(e,a), external(a,_).
code_value(b,a) :- flow(e,b), code_value(e,a).
points_to(e,b) :- pointer_seed(e,b).
points_to(e,b) :- scalar(e,a), global_aloc(b,start,size), a >= start, a < start+size.
points_to(b,p) :- flow(e,b), points_to(e,p).
points_to(e,b) :- binary(e,op,_,left,_),
    (op = "Add64"; op = "Add32"; op = "Sub64"; op = "Sub32"; op = "And64"; op = "And32"), points_to(left,b).
points_to(e,b) :- binary(e,op,_,_,right), (op = "Add64"; op = "Add32"), points_to(right,b).
points_to(e,b) :- heap_result(s,e,b), external_edge(s,n), (n = "malloc"; n = "calloc"; n = "realloc").

call_edge(s,g) :- call(s,f,_,_,e,_), reachable_func(f), code_value(e,a), function(g,a,_).
external_edge(s,n) :- call(s,f,_,_,e,_), reachable_func(f), code_value(e,a), external(a,n).

// Initial bytes are values of blocks, not executable-instruction constants.
memory_code(b,a) :- global_word(loc,a), global_aloc(b,start,size), loc >= start, loc < start+size, function(_,a,_).
memory_code(b,a) :- global_word(loc,a), global_aloc(b,start,size), loc >= start, loc < start+size, external(a,_).
memory_pointer(b,p) :- global_word(loc,a), global_aloc(b,start,size), loc >= start, loc < start+size,
    global_aloc(p,other,n), a >= other, a < other+n.
// Flow-insensitive weak updates: all possible writes contribute to a block.
memory_code(b,a) :- store(_,f,_,_,e,v), reachable_func(f), points_to(e,b), code_value(v,a).
memory_pointer(b,p) :- store(_,f,_,_,e,v), reachable_func(f), points_to(e,b), points_to(v,p).
code_value(v,a) :- load(_,f,_,_,e,v), reachable_func(f), points_to(e,b), memory_code(b,a).
points_to(v,p) :- load(_,f,_,_,e,v), reachable_func(f), points_to(e,b), memory_pointer(b,p).
// Conservative stack argument transfer (also covers x86 and AMD64 args > 6).
// Whole-frame blocks intentionally sacrifice per-slot precision.
memory_code(c,a) :- call_edge(s,g), call(s,f,_,_,_,_), stack_aloc(b,f,_,_), stack_aloc(c,g,_,_), memory_code(b,a).
memory_pointer(c,p) :- call_edge(s,g), call(s,f,_,_,_,_), stack_aloc(b,f,_,_), stack_aloc(c,g,_,_), memory_pointer(b,p).
.decl memory_transfer(dest:symbol, source:symbol)
memory_transfer(dest,source) :- external_edge(s,"realloc"), call_input(s,r,a), abi_first_arg(r),
    call_output(s,ret,result), abi_return(ret), points_to(a,source), points_to(result,dest).
memory_transfer(dest,source) :- external_edge(s,n), (n = "memcpy"; n = "memmove"; n = "strcpy"),
    call_input(s,r,a), abi_first_arg(r), call_input(s,q,b), abi_second_arg(q), points_to(a,dest), points_to(b,source).
memory_code(dest,a) :- memory_transfer(dest,source), memory_code(source,a).
memory_pointer(dest,p) :- memory_transfer(dest,source), memory_pointer(source,p).

.decl store_to_aloc(instr:number, value:number, block:symbol)
store_to_aloc(a,v,b) :- store(_,f,a,_,e,v), reachable_func(f), points_to(e,b).
.decl load_from_aloc(instr:number, value:number, block:symbol)
load_from_aloc(a,v,b) :- load(_,f,a,_,e,v), reachable_func(f), points_to(e,b).
.decl indirect_call_target(callSite:number, targetFunc:symbol)
indirect_call_target(a,g) :- call(s,_,_,a,_,1), call_edge(s,g).
.decl call_graph(caller:symbol, callee:symbol, site:number)
call_graph(f,g,a) :- call(s,f,_,a,_,_), call_edge(s,g).
.decl interproc_edge(source:number, target:number, kind:symbol)
interproc_edge(a,entry,"call") :- call(s,_,_,a,_,_), call_edge(s,g), function(g,entry,_).
interproc_edge(ret,dest,"return") :- call(s,f,b,_,_,_), call_edge(s,g), return_block(g,ret), edge(f,b,dest,"Ijk_FakeRet").
.decl unresolved_call(site:number)
unresolved_call(a) :- call(s,f,_,a,_,1), reachable_func(f), !call_edge(s,_), !external_edge(s,_).
.decl value_set(eid:number, value:number)
value_set(e,a) :- code_value(e,a).
.decl external_call_target(site:number, name:symbol)
external_call_target(a,n) :- call(s,_,_,a,_,_), external_edge(s,n).
// Unknown is recorded separately: an empty target set is never called safe.
.decl unknown_value(eid:number)
unknown_value(e) :- unknown_seed(e).
unknown_value(e) :- numeric_top(e).
unknown_value(b) :- flow(a,b), unknown_value(a).
unknown_value(e) :- unary(e,_,_,a), unknown_value(a).
unknown_value(e) :- binary(e,_,_,a,_), unknown_value(a).
unknown_value(e) :- binary(e,_,_,_,a), unknown_value(a).
unknown_value(e) :- binary(e,_,_,a,_), code_value(a,_).
unknown_value(e) :- binary(e,_,_,_,a), code_value(a,_).
unknown_value(e) :- unary(e,_,bits,a), pointer_width(w), bits < w, code_value(a,_).
.decl memory_unknown(block:symbol)
memory_unknown(b) :- store(_,f,_,_,a,v), reachable_func(f), points_to(a,b), unknown_value(v).
memory_unknown(b) :- memory_transfer(b,source), memory_unknown(source).
unknown_value(v) :- load(_,f,_,_,a,v), reachable_func(f), points_to(a,b), memory_unknown(b).
unknown_value(v) :- load(_,f,_,_,a,v), reachable_func(f), unknown_value(a).
.decl uncertain_call(site:number)
uncertain_call(a) :- call(_,f,_,a,e,1), reachable_func(f), unknown_value(e).

.output code_value(filename="code_value.facts")
.output value_set(filename="value_set.facts")
.output points_to(filename="points_to.facts")
.output memory_code(filename="memory_code.facts")
.output memory_pointer(filename="memory_pointer.facts")
.output store_to_aloc(filename="store_to_aloc.facts")
.output load_from_aloc(filename="load_from_aloc.facts")
.output call_graph(filename="call_graph.facts")
.output interproc_edge(filename="interproc_edge.facts")
.output indirect_call_target(filename="indirect_call_target.facts")
.output reachable_func(filename="reachable_func.facts")
.output unresolved_call(filename="unresolved_call.facts")
.output uncertain_call(filename="uncertain_call.facts")
.output external_call_target(filename="external_call_target.facts")
