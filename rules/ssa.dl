// Intraprocedural reaching definitions with instruction-internal order.
// Definition IDs become SSA-style value IDs; multiple incoming definitions
// are represented by separate def_use edges (no fictitious instruction IDs).
#include "schema.dl"
.decl has_def(func:symbol, bb:number, reg:number)
has_def(f,b,r) :- reg_def(_,f,b,_,r,_,_).
.decl last_def(func:symbol, bb:number, reg:number, version:number)
last_def(f,b,r,v) :- reg_def(_,f,b,o,r,_,v), o = max x : reg_def(_,f,b,x,r,_,_).
.decl reaching_entry(func:symbol, bb:number, reg:number, version:number)
.decl reaching_def_exit(func:symbol, bb:number, reg:number, version:number)
reaching_entry(f,b,r,v) :- block(f,b,1), entry_reg(f,r,v).
reaching_entry(f,b,r,v) :- edge(f,p,b,_), reaching_def_exit(f,p,r,v).
reaching_def_exit(f,b,r,v) :- last_def(f,b,r,v).
reaching_def_exit(f,b,r,v) :- reaching_entry(f,b,r,v), !has_def(f,b,r).
.decl earlier_def(dest:number)
earlier_def(d) :- reg_read(_,f,b,o,r,d), reg_def(_,f,b,p,r,_,_), p < o.
.decl def_use(source:number, dest:number)
def_use(v,d) :-
    reg_read(_,f,b,o,r,d), reg_def(_,f,b,p,r,_,v), p < o,
    p = max x : { reg_def(_,f,b,x,r,_,_), x < o }.
def_use(v,d) :- reg_read(_,f,b,_,r,d), !earlier_def(d), reaching_entry(f,b,r,v).
.decl ssa_def(func:symbol, bb:number, instr:number, reg:number, version:number)
ssa_def(f,b,a,r,v) :- reg_def(s,f,b,_,r,_,v), statement(s,f,b,a,_).
.decl ssa_use(func:symbol, instr:number, reg:number, version:number)
ssa_use(f,a,r,v) :- reg_read(s,f,_,_,r,d), statement(s,f,_,a,_), def_use(v,d).
.decl ssa_use_detail(stmt:number, expr:number, reg:number, version:number)
ssa_use_detail(s,d,r,v) :- reg_read(s,_,_,_,r,d), def_use(v,d).
.decl phi_node(func:symbol, bb:number, reg:number, incoming:number)
phi_node(f,b,r,v) :- reaching_entry(f,b,r,v), reaching_entry(f,b,r,w), v != w.
.decl exit_reg(func:symbol, reg:number, version:number)
exit_reg(f,r,v) :- return_block(f,b), reaching_def_exit(f,b,r,v).
.output def_use(filename="def_use.facts")
.output ssa_def(filename="ssa_def.facts")
.output ssa_use(filename="ssa_use.facts")
.output ssa_use_detail(filename="ssa_use_detail.facts")
.output reaching_def_exit(filename="reaching_def_exit.facts")
.output phi_node(filename="phi_node.facts")
.output exit_reg(filename="exit_reg.facts")
