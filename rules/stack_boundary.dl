// Conservative frame block; offsets are relative to function-entry SP.
// The Python affine prepass accumulates stack arithmetic through def-use.
.decl stack_access(func:symbol, offset:number, size:number)
.input stack_access
.decl extent(func:symbol, end_offset:number)
extent(f,o+s) :- stack_access(f,o,s).
.decl stack_boundary(func:symbol, offset:number, size:number)
stack_boundary(f,low,high-low) :- stack_access(f,_,_),
    low = min x : stack_access(f,x,_), high = max x : extent(f,x).
.output stack_boundary(filename="stack_boundary.facts")
