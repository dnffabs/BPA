// stack_boundary.dl — 栈内存块边界识别（BPA-X 算法）
//
// 修复：
//   1. holds_stack_ptr 传递闭包
//   2. binop 双侧匹配（tmp 在 arg1 或 arg2）
//   3. 64 位补码负数正确处理（Add64 大立即数 → 负偏移）
//   4. load（get_mem_vex_exp）和 store（set_mem_vex）都识别
//   5. addr_propagate 加 src != dst 防止自环
//
// 输入: filter_set_loc_vex, filter_set_mem_vex, filter_get_mem_vex_exp,
//        filter_binop_vex_exp, get_loc_vex_exp, imm_vex_exp, filtered_func
// 输出: stack_boundary(func, offset, size)

// ── 输入声明 ──────────────────────────────────────────────────────────────────

.decl filter_set_loc_vex(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:number, regEid:number)
.input filter_set_loc_vex

.decl filter_set_mem_vex(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:number, addrEid:number)
.input filter_set_mem_vex

.decl filter_get_mem_vex_exp(func:symbol, irsbAddr:number, instructionAddr:number, irOrder:number, size:number, dataEid:symbol, tmpEid:number)
.input filter_get_mem_vex_exp

.decl filter_binop_vex_exp(addr:number, op:symbol, arg1Eid:number, arg2Eid:number, resultEid:number)
.input filter_binop_vex_exp

.decl get_loc_vex_exp(regName:symbol, regEid:number)
.input get_loc_vex_exp

.decl filtered_func(func:symbol, start_addr:number, end_addr:number)
.input filtered_func

// ── Step 1: 识别 RSP/RBP 寄存器 EID ─────────────────────────────────────────

.decl stack_reg_eid(regEid:number)
stack_reg_eid(eid) :- get_loc_vex_exp("rsp", eid).
stack_reg_eid(eid) :- get_loc_vex_exp("rbp", eid).
stack_reg_eid(eid) :- get_loc_vex_exp("esp", eid).
stack_reg_eid(eid) :- get_loc_vex_exp("ebp", eid).

// ── Step 2: 追踪持有 RSP/RBP 值的临时变量（传递闭包）────────────────────────
// 修复1: 加递归规则，覆盖 t1=rsp, t2=t1, t3=t2 等多级传播

.decl holds_stack_ptr(func:symbol, tmpEid:number)
// 基础: t = GET(rsp/rbp)
holds_stack_ptr(func, tmpEid) :-
    filter_set_loc_vex(func, _, _, _, _, dataEid, tmpEid),
    stack_reg_eid(dataEid).
// 传递: t2 = t1（t1 已持有栈指针值）
holds_stack_ptr(func, dst) :-
    holds_stack_ptr(func, src),
    filter_set_loc_vex(func, _, _, _, _, src, dst),
    src != dst.

// ── Step 3: 立即数（有符号，由 extract_imm_signed.py 预处理）────────────────
// 修复3: 64 位补码负数由 Python 工具转换，避免 Soufflé to_number 溢出
// 格式: conEid  signedVal（绝对值 < 65536，非零）

.decl imm_as_signed(conEid:number, signedVal:number)
.input imm_as_signed(filename="imm_signed.facts")

// ── Step 4: 找 binop(tmp, imm) → 栈偏移 ─────────────────────────────────────
// 修复2: 双侧匹配（tmp 在 arg1 或 arg2）

.decl stack_arith(func:symbol, addr:number, op:symbol, immVal:number, resultEid:number)

// tmp 在 arg1: result = tmp OP imm
stack_arith(func, addr, op, immVal, resultEid) :-
    holds_stack_ptr(func, tmpEid),
    filter_binop_vex_exp(addr, op, tmpEid, immEid, resultEid),
    (op = "Sub64" ; op = "Sub32" ; op = "Add64" ; op = "Add32"),
    imm_as_signed(immEid, immVal),
    filtered_func(func, start, end),
    addr >= start, addr <= end.

// tmp 在 arg2: result = imm OP tmp（Add 可交换，Sub 不常见但也处理）
stack_arith(func, addr, op, immVal, resultEid) :-
    holds_stack_ptr(func, tmpEid),
    filter_binop_vex_exp(addr, op, immEid, tmpEid, resultEid),
    (op = "Add64" ; op = "Add32"),
    imm_as_signed(immEid, immVal),
    filtered_func(func, start, end),
    addr >= start, addr <= end.

// ── Step 5: 计算有符号偏移 ───────────────────────────────────────────────────
// Sub → offset = -|imm|（局部变量方向）
// Add 正数 → offset = +imm（参数方向）
// Add 负数（补码）→ offset = imm（已经是负数）

.decl stack_offset_signed(func:symbol, offset:number, resultEid:number)

// Sub: offset = -immVal（immVal 是正数）
stack_offset_signed(func, -immVal, resultEid) :-
    stack_arith(func, _, op, immVal, resultEid),
    (op = "Sub64" ; op = "Sub32"),
    immVal > 0.

// Add 正数: offset = +immVal（参数区域，offset > 0）
stack_offset_signed(func, immVal, resultEid) :-
    stack_arith(func, _, op, immVal, resultEid),
    (op = "Add64" ; op = "Add32"),
    immVal > 0.

// Add 负数（64位补码，to_number 溢出为负）: offset = immVal（已是负数）
stack_offset_signed(func, immVal, resultEid) :-
    stack_arith(func, _, op, immVal, resultEid),
    (op = "Add64" ; op = "Add32"),
    immVal < 0.

// ── Step 6: 追踪地址传播 ─────────────────────────────────────────────────────
// 修复5: 加 src != dst 防止自环

.decl addr_propagate(func:symbol, srcEid:number, dstEid:number)
addr_propagate(func, eid, eid) :-
    stack_offset_signed(func, _, eid).
addr_propagate(func, srcEid, dstEid) :-
    addr_propagate(func, srcEid, midEid),
    filter_set_loc_vex(func, _, _, _, _, midEid, dstEid),
    srcEid != dstEid.

// ── Step 7: 识别被 load/store 使用的偏移 ─────────────────────────────────────

.decl used_as_mem_addr(func:symbol, srcEid:number, accessSize:number)

// store: set_mem_vex 的 addrEid 直接是地址
used_as_mem_addr(func, srcEid, size) :-
    addr_propagate(func, srcEid, addrEid),
    filter_set_mem_vex(func, _, _, _, size, _, addrEid).

// load: filter_get_mem_vex_exp 的 tmpEid 就是地址表达式 EID
used_as_mem_addr(func, srcEid, size) :-
    addr_propagate(func, srcEid, addrEid),
    filter_get_mem_vex_exp(func, _, _, _, size, _, addrEid).

// ── Step 8: 生成候选栈边界 ───────────────────────────────────────────────────

.decl stack_boundary_candidate(func:symbol, offset:number, size:number)

// 局部变量: offset <= 0 且被 load/store 使用
stack_boundary_candidate(func, offset, size) :-
    stack_offset_signed(func, offset, resultEid),
    offset <= 0,
    used_as_mem_addr(func, resultEid, size),
    size > 0.

// 函数序言: rsp = rsp - imm（resultEid 写回栈指针寄存器）
stack_boundary_candidate(func, offset, 8) :-
    stack_offset_signed(func, offset, resultEid),
    offset < 0,
    filter_set_loc_vex(func, _, _, _, _, resultEid, regEid),
    stack_reg_eid(regEid).

// 参数: offset > 0，限制在合理范围内（< 1024），排除结构体指针字段访问
stack_boundary_candidate(func, offset, size) :-
    stack_offset_signed(func, offset, resultEid),
    offset > 0, offset < 1024,
    used_as_mem_addr(func, resultEid, size),
    size > 0.

// ── Step 9: 过滤内部地址 ─────────────────────────────────────────────────────
// 栈 offset 是负数，区间 [offset, offset+size) 向正方向延伸
// 若 offset2 落在 [offset1, offset1+size1) 内且不等于 offset1 → 是内部地址

.decl is_inner_offset(func:symbol, offset:number)
is_inner_offset(func, offset2) :-
    stack_boundary_candidate(func, offset1, size1),
    stack_boundary_candidate(func, offset2, _),
    offset2 != offset1,
    offset2 >= offset1,
    offset2 < offset1 + size1.

// ── 最终输出：对同一 (func, offset) 取最大 size ───────────────────────────────

.decl stack_boundary(func:symbol, offset:number, size:number)
stack_boundary(func, offset, size) :-
    stack_boundary_candidate(func, offset, size),
    !is_inner_offset(func, offset),
    size = max s : stack_boundary_candidate(func, offset, s).

.output stack_boundary(filename="stack_boundary.facts")
